# /etc/eshop/catalog-api.env - Catalog.API configuration (systemd EnvironmentFile).
# GENERATED by deploy/ubuntu/provision-host.sh from env/catalog-api.env.tmpl with envsubst.
# Do not edit by hand. Shared keys (event bus, redis, environment) live in common.env.
#
# Catalog.API only ships a ConnectionStrings:CatalogDB in appsettings.Development.json;
# in Production its database connection comes exclusively from this file.

ASPNETCORE_URLS=http://127.0.0.1:${SERVICE_PORT}

# Npgsql keyword connection string consumed by AddNpgsqlDbContext("catalogdb").
ConnectionStrings__catalogdb=Host=127.0.0.1;Port=5432;Database=catalogdb;Username=${ESHOP_PG_ROLE};Password=${POSTGRES_PASSWORD}

# Optional AI embeddings (disabled by default; Catalog works without them):
#OllamaEnabled=true
#ConnectionStrings__textEmbeddingModel=Endpoint=...;Key=...
