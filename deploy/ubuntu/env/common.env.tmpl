# /etc/eshop/common.env - shared eShop configuration contract (systemd EnvironmentFile).
# GENERATED by deploy/ubuntu/provision-host.sh from env/common.env.tmpl with envsubst.
# Do not edit by hand: changes are overwritten on the next provisioning run.
# Secrets come from /etc/eshop/secrets.env (root only) and are never regenerated.
#
# Loaded by every eshop-*.service unit before its own /etc/eshop/<service>.env.

# --- ASP.NET Core host -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Behind a reverse proxy the scheme/host come from X-Forwarded-* headers
# (same flag the Aspire AppHost injected for every project).
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# Opt-in switch read by eShop.ServiceDefaults: maps /health and /alive outside Development.
ESHOP_EXPOSE_HEALTH_ENDPOINTS=true
DOTNET_NOLOGO=1
DOTNET_CLI_TELEMETRY_OPTOUT=1

# --- Connection strings (same names Aspire injected; client packages unchanged) ----
# RabbitMQ: Aspire.RabbitMQ.Client expects an AMQP URI; the path is the vhost.
ConnectionStrings__eventbus=amqp://${ESHOP_RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${ESHOP_LOOPBACK_ADDR}:${ESHOP_AMQP_PORT}/${ESHOP_RABBITMQ_VHOST}
# Redis: StackExchange.Redis configuration string.
ConnectionStrings__redis=${ESHOP_LOOPBACK_ADDR}:${ESHOP_REDIS_PORT},password=${REDIS_PASSWORD}

# --- Service discovery (Microsoft.Extensions.ServiceDiscovery configuration provider) ---
# Contract key form: Services__<name>__http__0=<url>. systemd EnvironmentFile= rejects
# variable names containing '-' (all service names do), so the keys below are
# documentation only. The units pass the very same endpoints as command-line
# configuration arguments (Services:<name>:http:0) through ESHOP_CONFIG_ARGS.
${ESHOP_SERVICES_DOC}
ESHOP_CONFIG_ARGS="${ESHOP_CONFIG_ARGS}"

# --- Telemetry (optional) ------------------------------------------------------------
# Uncomment to export traces/metrics/logs through OTLP; logs always go to journald.
#OTEL_EXPORTER_OTLP_ENDPOINT=http://${ESHOP_LOOPBACK_ADDR}:4317
